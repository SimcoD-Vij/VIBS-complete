# ─────────────────────────────────────────────────────
# VIBS — Environment Variables
# Copy this file to .env and fill in your values.
# The .env file is gitignored and never committed.
# ─────────────────────────────────────────────────────

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://vibs_user:vibs_pass@postgres:5432/vibs
REDIS_URL=redis://redis:6379

# ── HuggingFace (REQUIRED for speaker diarization) ──
# 1. Create a free account at https://huggingface.co
# 2. Go to Settings → Access Tokens → New token (read)
# 3. Accept the model license at:
#    https://huggingface.co/pyannote/speaker-diarization-3.1
#    https://huggingface.co/speechbrain/spkrec-ecapa-voxceleb
# 4. Paste the token below
HF_TOKEN=hf_your_token_here

# ── LLM Provider (pick ONE, others can be blank) ────
# Used for: per-speaker summarization, knowledge graph, graph explanation
# Groq is recommended — it's free and very fast (~700 tokens/sec)
# Sign up at: https://console.groq.com

LLM_PROVIDER=groq          # groq | openai | anthropic | ollama

GROQ_API_KEY=gsk_your_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (if LLM_PROVIDER=ollama) — must be running separately
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# ── Audio / ML Settings ──────────────────────────────
AUDIO_DIR=/audio_files

# Whisper model size (affects speed vs accuracy)
# tiny.en  → fastest, English only, ~1GB RAM
# base     → balanced, multilingual, ~1.5GB RAM
# small    → better accuracy, ~2.5GB RAM
# medium   → high accuracy, ~5GB RAM (GPU recommended)
WHISPER_MODEL=tiny.en

# Realtime chunk size in seconds
# Lower = lower latency, but less context for Whisper
# 1.5 = minimum recommended
# 2.0 = default (good balance)
# 3.0 = better accuracy on slow hardware
REALTIME_CHUNK_SECONDS=2.0

# Speaker similarity threshold (cosine distance)
# 0.65 = more speakers detected (sensitive)
# 0.72 = default (balanced)
# 0.80 = fewer speakers detected (strict)
SPEAKER_SIMILARITY_THRESHOLD=0.72

# Max speakers to track per session
MAX_SPEAKERS=10

# Auto-stop after this many seconds of silence (realtime mic)
SILENCE_THRESHOLD_SECONDS=600
